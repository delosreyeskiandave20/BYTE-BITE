rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Shop documents are keyed by the owner's Firebase Auth UID, so document
    // ownership is enough. The owner's email is never stored in plain text.
    function isShopOwner(ownerId) {
      return signedIn() && request.auth.uid == ownerId;
    }

    function isVerifiedShop() {
      return resource.data.verified == true;
    }

    // Products have no "verified" field of their own; buyers may read them
    // when the parent shop is verified.
    function parentShopVerified(ownerId) {
      return get(/databases/$(database)/documents/shops/$(ownerId)).data.verified
        == true;
    }

    // Shape and size validation for every shop write. Keep these limits in sync
    // with ShopStore and the owner dashboard form.
    function validShop() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'ownerEmailHash',
          'ownerName',
          'name',
          'location',
          'description',
          'contact',
          'marketplaceUrl',
          'marketplaceApproved',
          'verified',
          'lastEditedAt',
          'bannerUrl'
        ])
        && data.keys().hasAll([
          'ownerEmailHash',
          'ownerName',
          'name',
          'location',
          'description',
          'verified'
        ])
        && data.ownerEmailHash is string
        && data.ownerEmailHash.size() == 64
        && data.ownerEmailHash.matches('^[0-9a-f]{64}$')
        && data.ownerName is string
        && data.ownerName.size() <= 120
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 120
        && data.location is string
        && data.location.size() >= 1
        && data.location.size() <= 120
        && data.description is string
        && data.description.size() <= 2000
        && (!('contact' in data)
          || (data.contact is string && data.contact.size() <= 120))
        // Optional: the seller's own Shopee or Lazada store link.
        && (!('marketplaceUrl' in data)
          || (data.marketplaceUrl is string
            && data.marketplaceUrl.size() <= 200
            && (data.marketplaceUrl == ''
              || data.marketplaceUrl.matches(
                '^https://(shopee\\.ph|www\\.lazada\\.com\\.ph/shop)/[A-Za-z0-9._-]+/?$'))))
        && (!('marketplaceApproved' in data) || data.marketplaceApproved is bool)
        && data.verified is bool
        && (!('lastEditedAt' in data)
          || (data.lastEditedAt is int
            && data.lastEditedAt >= 0
            && data.lastEditedAt <= 4102444800000));
    }

    // Clients may only publish a shop when Firebase Auth has verified the owner
    // email. A verified shop cannot be un-verified by the client.
    function validVerificationState() {
      let verified = request.resource.data.verified;
      return (!verified || request.auth.token.email_verified == true)
        && (!(resource != null && resource.data.verified == true)
          || verified == true);
    }

    // Products live in their own subcollection so each document can be
    // validated individually. Keep these limits in sync with ShopStore.
    function validProduct() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'id',
          'name',
          'category',
          'description',
          'price',
          'quantity',
          'imageUrl',
          'motorcycles',
          'photoUrls',
          'part',
          'customPart',
          'brand',
          'condition',
          'fitsAll',
          'specLabel',
          'specs'
        ])
        && data.keys().hasAll([
          'id',
          'name',
          'category',
          'description',
          'price',
          'quantity',
          'imageUrl'
        ])
        && data.id is string
        && data.id.size() >= 1
        && data.id.size() <= 64
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 120
        && data.category is string
        && data.category.size() >= 1
        && data.category.size() <= 60
        && data.description is string
        && data.description.size() <= 1000
        && data.price is number
        && data.price >= 0
        && data.price <= 10000000
        && data.quantity is int
        && data.quantity >= 0
        && data.quantity <= 100000
        && data.imageUrl is string
        && data.imageUrl.size() <= 500
        && (data.imageUrl == ''
          || data.imageUrl.matches('^https://[A-Za-z0-9._~:/?#\\[\\]@!$&()*+,;=%-]+$'))
        // Optional: the motorcycles the seller checked as ones the item fits.
        && (!('motorcycles' in data)
          || (data.motorcycles is list && data.motorcycles.size() <= 100))
        // Optional: extra uploaded photos after the main imageUrl.
        && (!('photoUrls' in data)
          || (data.photoUrls is list && data.photoUrls.size() <= 7))
        // Optional Add Item fields: part (custom ones flagged for review),
        // brand, condition, "fits all" and per-motorcycle spec values.
        && (!('part' in data) || (data.part is string && data.part.size() <= 60))
        && (!('customPart' in data) || data.customPart is bool)
        && (!('brand' in data) || (data.brand is string && data.brand.size() <= 60))
        && (!('condition' in data)
          || data.condition in ['', 'New', 'Used', 'Surplus'])
        && (!('fitsAll' in data) || data.fitsAll is bool)
        && (!('specLabel' in data)
          || (data.specLabel is string && data.specLabel.size() <= 60))
        && (!('specs' in data)
          || (data.specs is list && data.specs.size() <= 100));
    }

    // Only the app admin approves a Shopee/Lazada link, in the Firebase
    // console. Owners may keep an existing approval while the link is
    // unchanged, or clear it, but never grant it.
    function validMarketplaceApproval() {
      let data = request.resource.data;
      return data.get('marketplaceApproved', false) == false
        || (resource != null
          && resource.data.get('marketplaceApproved', false) == true
          && data.get('marketplaceUrl', '')
            == resource.data.get('marketplaceUrl', ''));
    }

    // Optional shop picture uploaded by the owner: empty, or an https link.
    function validBanner() {
      let data = request.resource.data;
      return !('bannerUrl' in data)
        || (data.bannerUrl is string
          && data.bannerUrl.size() <= 500
          && (data.bannerUrl == ''
            || data.bannerUrl.matches('^https://[A-Za-z0-9._~:/?#\\[\\]@!$&()*+,;=%-]+$')));
    }

    match /shops/{ownerId} {
      // Public marketplace reads only verified shops. Owners can read their own
      // shop before verification to complete setup.
      allow read: if isVerifiedShop() || isShopOwner(ownerId);
      allow create, update: if isShopOwner(ownerId)
        && validShop()
        && validVerificationState()
        && validMarketplaceApproval()
        && validBanner();
      allow delete: if isShopOwner(ownerId);

      match /products/{productId} {
        allow read: if isShopOwner(ownerId) || parentShopVerified(ownerId);
        allow create, update: if isShopOwner(ownerId)
          && validProduct()
          && request.resource.data.id == productId;
        allow delete: if isShopOwner(ownerId);
      }
    }

    // ---- Buyer <-> seller chat ----
    // chats/{shopId_buyerUid}: one chat per buyer per shop. The shop document
    // ID is the owner's UID, so the seller is the user whose UID == shopId.
    // Buyers are Firebase Anonymous (guest) users or other signed-in users.

    function isChatMember(chat) {
      return signedIn()
        && (request.auth.uid == chat.buyerUid || request.auth.uid == chat.shopId);
    }

    function validChat() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'shopId',
          'shopName',
          'buyerUid',
          'buyerName',
          'productName',
          'lastMessage',
          'lastSenderUid',
          'updatedAt',
          'buyerUnread',
          'sellerUnread'
        ])
        && data.keys().hasAll([
          'shopId',
          'shopName',
          'buyerUid',
          'buyerName',
          'lastMessage',
          'lastSenderUid',
          'updatedAt',
          'buyerUnread',
          'sellerUnread'
        ])
        && data.shopId is string && data.shopId.size() > 0
        && data.shopName is string && data.shopName.size() <= 120
        && data.buyerUid is string && data.buyerUid.size() > 0
        && data.buyerName is string
        && data.buyerName.size() >= 1 && data.buyerName.size() <= 60
        && (!('productName' in data)
          || (data.productName is string && data.productName.size() <= 120))
        && data.lastMessage is string && data.lastMessage.size() <= 1000
        && data.lastSenderUid is string
        && data.updatedAt is int
        && data.buyerUnread is int && data.buyerUnread >= 0
        && data.sellerUnread is int && data.sellerUnread >= 0;
    }

    match /chats/{chatId} {
      // A chat that does not exist yet may be looked up (it reveals nothing),
      // so a buyer's new chat opens before the first message is sent.
      allow get: if resource == null || isChatMember(resource.data);
      allow list: if isChatMember(resource.data);
      // Only the buyer starts a chat, with a real shop, under the fixed ID.
      allow create: if signedIn()
        && validChat()
        && request.resource.data.buyerUid == request.auth.uid
        && request.resource.data.shopId != request.auth.uid
        && chatId == request.resource.data.shopId + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/shops/$(request.resource.data.shopId));
      // Members only update the summary and unread counts; who is in the chat
      // never changes.
      allow update: if isChatMember(resource.data)
        && validChat()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'productName',
          'lastMessage',
          'lastSenderUid',
          'updatedAt',
          'buyerUnread',
          'sellerUnread'
        ]);
      allow delete: if false;

      match /messages/{messageId} {
        // getAfter: the first message is written in the same batch that
        // creates the chat.
        allow read: if isChatMember(
          get(/databases/$(database)/documents/chats/$(chatId)).data);
        allow create: if isChatMember(
            getAfter(/databases/$(database)/documents/chats/$(chatId)).data)
          && request.resource.data.keys().hasOnly([
            'senderUid',
            'text',
            'sentAt',
            'productId',
            'productName',
            'productPrice',
            'productImage'
          ])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000
          && request.resource.data.sentAt is int
          && validChatItem(
            getAfter(/databases/$(database)/documents/chats/$(chatId)).data.shopId);
        allow update, delete: if false;
      }
    }

    // The item a message asks about: either none, or all four fields for an
    // item that really belongs to this chat's shop.
    function validChatItem(shopId) {
      let data = request.resource.data;
      return (!('productId' in data)
          && !('productName' in data)
          && !('productPrice' in data)
          && !('productImage' in data))
        || (data.productId is string
          && data.productId.size() > 0
          && data.productId.size() <= 120
          && data.productName is string
          && data.productName.size() >= 1
          && data.productName.size() <= 120
          && data.productPrice is number
          && data.productPrice >= 0
          && data.productImage is string
          && data.productImage.size() <= 500
          && (data.productImage == ''
            || data.productImage.matches('^https://[A-Za-z0-9._~:/?#\\[\\]@!$&()*+,;=%-]+$'))
          && exists(/databases/$(database)/documents/shops/$(shopId)/products/$(data.productId)));
    }
  }
}
