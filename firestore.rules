  rules_version = '2';

  service cloud.firestore {
    match /databases/{database}/documents {
      function signedIn() {
        return request.auth != null;
      }

      // Shop documents are keyed by the owner's Firebase Auth UID, so document
      // ownership is enough. The owner's email is never stored in plain text.
      function isShopOwner(ownerId) {
        return signedIn() && request.auth.uid == ownerId;
      }

      // Shape and size validation for every shop write. Keep these limits in
      // sync with ShopStore and the owner dashboard form.
      function validShop() {
        let data = request.resource.data;
        return data.keys().hasAll([
            'ownerEmailHash',
            'ownerName',
            'name',
            'location',
            'description'
          ])
          && data.ownerEmailHash is string
          && data.ownerEmailHash.size() == 64
          && data.ownerEmailHash.matches('^[0-9a-f]{64}$')
          && data.ownerName is string
          && data.ownerName.size() <= 120
          && data.name is string
          && data.name.size() >= 1
          && data.name.size() <= 120
          && data.location is string
          && data.location.size() >= 1
          && data.location.size() <= 120
          && data.description is string
          && data.description.size() <= 2000;
      }

      // Products live in their own subcollection so each document can be
      // validated individually. Keep these limits in sync with ShopStore.
      function validProduct() {
        let data = request.resource.data;
        return data.keys().hasAll([
            'id',
            'name',
            'category',
            'description',
            'price',
            'quantity',
            'imageUrl'
          ])
          && data.id is string
          && data.id.size() >= 1
          && data.id.size() <= 64
          && data.name is string
          && data.name.size() >= 1
          && data.name.size() <= 120
          && data.category is string
          && data.category.size() >= 1
          && data.category.size() <= 60
          && data.description is string
          && data.description.size() <= 1000
          && data.price is number
          && data.price >= 0
          && data.price <= 10000000
          && data.quantity is int
          && data.quantity >= 0
          && data.quantity <= 100000
          && data.imageUrl is string
          && data.imageUrl.size() <= 500
          && (data.imageUrl == '' || data.imageUrl.matches('^https?://.+'));
      }

      match /shops/{ownerId} {
        // Shop listings are public so anyone can browse the marketplace.
        allow read: if true;
        allow create, update: if isShopOwner(ownerId) && validShop();
        allow delete: if isShopOwner(ownerId);

        match /products/{productId} {
          allow read: if true;
          allow create, update: if isShopOwner(ownerId)
            && validProduct()
            && request.resource.data.id == productId;
          allow delete: if isShopOwner(ownerId);
        }
      }
    }
  }
