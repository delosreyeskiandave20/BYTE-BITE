rules_version = '2';

// Item photos uploaded from the shop's Add Item page. Anyone can view them;
// only the signed-in owner of the shop (shop id = Firebase Auth uid) can add
// or remove them. JPG, PNG or WEBP only, up to 10 MB each.
service firebase.storage {
  match /b/{bucket}/o {
    match /shops/{ownerId}/products/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == ownerId
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == ownerId;
    }
  }
}
